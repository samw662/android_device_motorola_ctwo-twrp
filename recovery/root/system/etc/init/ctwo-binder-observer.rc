# Operator-triggered Binder registration checks.
on init
    mount erofs loop@/system/etc/ctwo-binder-observer.erofs /system/bin/ctwo-tools ro nosuid nodev

service ctwo_binder_check_keymint /system/bin/ctwo-tools/ctwo-binder-observer android.hardware.security.keymint.IKeyMintDevice/default
    class core
    user system
    group system
    disabled
    oneshot
    timeout_period 10

service ctwo_binder_check_sharedsecret /system/bin/ctwo-tools/ctwo-binder-observer android.hardware.security.sharedsecret.ISharedSecret/default
    class core
    user system
    group system
    disabled
    oneshot
    timeout_period 10

service ctwo_binder_check_secureclock /system/bin/ctwo-tools/ctwo-binder-observer android.hardware.security.secureclock.ISecureClock/default
    class core
    user system
    group system
    disabled
    oneshot
    timeout_period 10

service ctwo_binder_check_qseecom /system/bin/ctwo-tools/ctwo-binder-observer vendor.qti.hardware.qseecom.IQSEECom/default
    class core
    user system
    group system
    disabled
    oneshot
    timeout_period 10
